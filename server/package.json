{
  "name": "temel-lms-server",
  "version": "1.0.0",
  "private": true,
  "description": "Basic LMS: Express API (backend)",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/server.js",
